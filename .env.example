# ==============================================================================
# FieldOps Environment Configuration & Secrets Template
# ==============================================================================
# HOW TO GENERATE SECRETS & KEYS:
#
# 1. OpenSSL (Linux / Mac Terminal):
#    - Generate 32-byte (64 hex chars) secret: openssl rand -hex 32
#    - Generate 16-byte random password:       openssl rand -hex 16
#
# 2. Python 3 (Cross-platform alternative):
#    - Generate secret token:                  python3 -c "import secrets; print(secrets.token_hex(32))"
#
# 3. Master Encryption Key (for AES-256-GCM credential encryption):
#    - Linux / Production:                     openssl rand -hex 32 | sudo tee /etc/deployment-tracker/secrets/master.key
#    - Local Development:                      openssl rand -hex 32 > /tmp/master.key
# ==============================================================================

# Database Password (PostgreSQL)
# Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=supersecurepassword123

# JWT Secret Key (used for signing authentication tokens)
# Generate with: openssl rand -hex 32
JWT_SECRET=supersecurejwtsecret123

# MinIO S3 Root Admin Password
# Generate with: openssl rand -hex 16
MINIO_PASSWORD=supersecureminiopassword123

# Master Key Path (AES-256-GCM 32-byte hex key for encrypted credential storage)
MASTER_KEY_PATH=/tmp/master.key

# Application Environment: 'development' or 'production'
ENVIRONMENT=development
